# Application Environment Variables Example

# Server
PORT=8080

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ticket_db
DB_USERNAME=ticket_user
DB_PASSWORD=ticket_pass
DB_URL=jdbc:postgresql://localhost:5432/ticket_db

# Flyway Migrations
FLYWAY_ENABLED=true

# Redis Cache & Locking
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ Message Broker
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

